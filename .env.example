# ==============================================================================
# AURORA HOTELS & BOOKINGS — ENVIRONMENT VARIABLES SPECIFICATION
# ==============================================================================

# --- Firebase Client SDK Configuration ---
# Create a Firebase project at https://console.firebase.google.com/
# Enable Authentication (Email/Password) and Cloud Firestore.
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# --- Google Gemini AI API Key ---
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
#
# ARCHITECTURAL NOTE FOR PRODUCTION:
# In this development configuration, VITE_GEMINI_API_KEY is used by the frontend
# client for interactive demo purposes. Vite bundles VITE_ variables into the browser
# client build. For a commercial production release, proxy Gemini requests through
# a secure Firebase Cloud Function or serverless backend to safeguard your API key.
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# --- Admin Initial Setup Security Key ---
# Used to claim initial administrator privileges in the Admin Portal.
VITE_ADMIN_SETUP_CODE=AURORA_ADMIN_2026
