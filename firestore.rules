rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: check if request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function: check if current user is an administrator
    function isAdmin() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         request.auth.token.role == 'admin');
    }

    // Helper function: check if current user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // USERS COLLECTION
    // Guests can read and modify only their own profile.
    // Customers can NEVER grant themselves or modify the 'role' field.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && request.auth.uid == userId &&
        (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role == 'customer');
      allow update: if (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])) || isAdmin();
      allow delete: if isAdmin();
    }

    // ROOMS COLLECTION
    // Catalog is publicly readable. Adding, editing, and toggling active status is strictly admin-only.
    match /rooms/{roomId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // SERVICES COLLECTION
    // Configurable services are publicly readable. Management is admin-only.
    match /services/{serviceId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // BOOKINGS COLLECTION
    // Guests can read only their own bookings. Admins can read and manage all bookings.
    // Double booking prevention enforced concurrency transactions.
    match /bookings/{bookingId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']));
      allow delete: if isAdmin();
    }

    // REVIEWS COLLECTION
    // Public can read only approved reviews. Authenticated guests can create their review.
    // Moderation (approval, rejection, deletion) is strictly admin-only.
    match /reviews/{reviewId} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // SETTINGS COLLECTION
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
