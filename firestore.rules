rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: check if request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function: check if current user is an administrator
    function isAdmin() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         request.auth.token.role == 'admin');
    }

    // Helper function: check if current user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // USERS COLLECTION
    // Guests can read and modify only their own profile. Only admins can view all users.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ROOMS COLLECTION
    // Room catalog is publicly readable. Adding, editing, and toggling active status is strictly admin-only.
    match /rooms/{roomId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // SERVICES COLLECTION
    // Configurable services (breakfast, tea, linens, transport) are publicly readable. Write is admin-only.
    match /services/{serviceId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // BOOKINGS COLLECTION
    // Sensitive guest identities (including CNIC) are protected.
    // Customers can read only their own bookings. Admins can read all bookings.
    // Double booking prevention & transaction validation enforced.
    match /bookings/{bookingId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() || request.resource.data.userId == 'guest-reservation';
      allow update: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']));
      allow delete: if isAdmin();
    }

    // SETTINGS COLLECTION
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
